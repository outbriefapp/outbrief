---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="screen not-content">
  <Image src={src} alt={alt} widths={[640, 1280]} sizes="(max-width: 50rem) 100vw, 46rem" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screen {
    margin: 1.5rem 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>

---
interface Props {
  lang?: "zh" | "en";
}

const { lang = "zh" } = Astro.props;

const text = {
  zh: {
    computer: "你的电脑",
    agents: "Claude Code · Codex · Multica",
    daemon: "生成简报，加密",
    server: "只转发密文，看不到内容",
    devices: "手机 / 桌面 App",
    app: "响铃 · 播报 · 回复",
    report: "汇报",
    reply: "回复",
    sealed: "密文",
    caption: "汇报从电脑出发，加密后经 server 送到你的设备；回复沿原路返回。",
  },
  en: {
    computer: "Your computer",
    agents: "Claude Code · Codex · Multica",
    daemon: "Writes the brief, encrypts",
    server: "Relays ciphertext, reads nothing",
    devices: "Phone / desktop app",
    app: "Rings · speaks · replies",
    report: "Report",
    reply: "Reply",
    sealed: "encrypted",
    caption:
      "A report leaves your computer encrypted and reaches your devices through the server. The reply takes the same way back.",
  },
}[lang];
---

<figure class="arch not-content">
  <div class="flow">
    <div class="node">
      <span class="eyebrow">{text.computer}</span>
      <span class="agents">{text.agents}</span>
      <span class="name">outbrief-daemon</span>
      <span class="desc">{text.daemon}</span>
    </div>
    <div class="link">
      <span class="arrow right">{text.report} · {text.sealed}</span>
      <span class="arrow left">{text.reply} · {text.sealed}</span>
    </div>
    <div class="node relay">
      <span class="eyebrow">outbrief-server</span>
      <span class="name">Relay</span>
      <span class="desc">{text.server}</span>
    </div>
    <div class="link">
      <span class="arrow right">{text.report} · {text.sealed}</span>
      <span class="arrow left">{text.reply} · {text.sealed}</span>
    </div>
    <div class="node">
      <span class="eyebrow">{text.devices}</span>
      <span class="name">outbrief-app</span>
      <span class="desc">{text.app}</span>
    </div>
  </div>
  <figcaption>{text.caption}</figcaption>
</figure>

<style>
  .arch {
    margin: 1.5rem 0;
  }

  .flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    text-align: center;
  }

  .relay {
    border-style: dashed;
    background: transparent;
  }

  .eyebrow {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .agents {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent-high);
  }

  .name {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .desc {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .arrow::before,
  .arrow::after {
    color: var(--sl-color-accent);
  }

  .right::after {
    content: " →";
  }

  .left::before {
    content: "← ";
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  @media (max-width: 50rem) {
    .flow {
      grid-template-columns: 1fr;
    }

    .link {
      align-items: center;
    }

    .right::after {
      content: " ↓";
    }

    .left::before {
      content: "↑ ";
    }
  }
</style>
